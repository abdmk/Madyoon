# ---------------------------------------------------------------------------
# Supabase — project "Madyoon"
# Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zhkaddbfnwpjdzlfchwd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# The app's one canonical production URL. Every auth redirect (Google OAuth,
# email confirmation links, the post-login landing) is built from this, not
# from whatever domain the browser happens to be on — that's what used to
# send people to random *.vercel.app preview aliases mid-login.
#
# REQUIRED in Vercel Production (Settings → Environment Variables →
# Production scope) — set to the app's real production URL, e.g.
# https://madyoon.vercel.app. src/lib/site-url.ts throws a clear error at
# runtime if this is missing on a real Production deployment; it does not
# silently fall back to the request's host there.
#
# Leave unset locally and on Preview deployments — both fall back to the
# current origin automatically (see getSiteUrl in src/lib/site-url.ts).
# That distinction is made via Vercel's own NEXT_PUBLIC_VERCEL_ENV, which
# Vercel injects automatically — nothing to configure for it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://madyoon.vercel.app

# ---------------------------------------------------------------------------
# Anthropic — powers the AI assistant at /chatbot.
# Server-side only; never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
