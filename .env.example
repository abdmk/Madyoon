# ---------------------------------------------------------------------------
# Supabase — project "Madyoon"
# Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zhkaddbfnwpjdzlfchwd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# The app's one canonical production URL. Every auth redirect (Google OAuth,
# email confirmation links, the post-login landing) is built from this, not
# from whatever domain the browser happens to be on — that's what used to
# send people to random *.vercel.app preview aliases mid-login.
#
# Set this in Vercel → Settings → Environment Variables, scoped to
# Production only, to the app's real production URL (e.g.
# https://madyoon.vercel.app or a custom domain). Leave unset locally —
# local dev falls back to the current origin automatically.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://madyoon.vercel.app

# ---------------------------------------------------------------------------
# Anthropic — powers the AI assistant at /chatbot.
# Server-side only; never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
